V5AI_DATASOURCE_URL=jdbc:postgresql://localhost:5432/v5ai_nb
V5AI_DATASOURCE_USERNAME=v5ai
V5AI_DATASOURCE_PASSWORD=change-me
V5AI_JWT_SECRET=change-this-development-secret
V5AI_CREDENTIAL_CIPHER_KEY=replace-with-32-byte-secret-value
V5AI_REDIS_ADDRESS=redis://localhost:6379
V5AI_MINIO_ENDPOINT=http://localhost:9000
V5AI_MINIO_ACCESS_KEY=minioadmin
V5AI_MINIO_SECRET_KEY=minioadmin
V5AI_MINIO_BUCKET=v5ai
# 可选：文档上传大小限制（默认 50MB / 请求 60MB）
V5AI_UPLOAD_MAX_FILE_SIZE=50MB
V5AI_UPLOAD_MAX_REQUEST_SIZE=60MB
# 可选：模型连通性测试超时（毫秒，默认 90000=90s；Ollama 冷启动加载大模型可能较慢）
# 对应属性 v5ai.model.connection.test.timeout.ms
V5AI_MODEL_CONNECTION_TEST_TIMEOUT_MS=90000
# 可选：Embedding 模型通过 Admin API 配置；未配置时使用本地 Hash 嵌入（1536 维）
