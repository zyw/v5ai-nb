# =============================================================================
# v5ai-nb 环境变量样例
#
# 用法：cp .env.example .env，改好值后 `set -a; source .env; set +a` 再启动后端
#       （Spring Boot 不自动读取 .env 文件，也可以在 shell 里直接 export）。
# 范围：本文件只列「支持用环境变量覆盖」的配置项；全部配置项（含默认值与可选值）
#       见 README「配置项一览（v5ai.*）」与 v5ai-starter/src/main/resources/application.yml.template。
# =============================================================================

# -----------------------------------------------------------------------------
# 必填：生产环境必须显式设置
# -----------------------------------------------------------------------------
# PostgreSQL + pgvector 库连接（对应 spring.datasource.*）
V5AI_DATASOURCE_URL=jdbc:postgresql://localhost:5432/v5ai_nb
V5AI_DATASOURCE_USERNAME=v5ai
V5AI_DATASOURCE_PASSWORD=change-me
# Sa-Token JWT 签名密钥（对应 sa-token.jwt-secret-key）
V5AI_JWT_SECRET=change-this-development-secret
# 凭据加密密钥（对应 v5ai.crypto.secret-key）：必须 32 字节
# ⚠️ 更换密钥后已存的模型 API Key 等凭据无法解密，需重新录入
V5AI_CREDENTIAL_CIPHER_KEY=replace-with-32-byte-secret-value

# -----------------------------------------------------------------------------
# Redis（Redisson；限流/缓存用，多实例部署必需）
# -----------------------------------------------------------------------------
V5AI_REDIS_HOST=192.168.10.13
V5AI_REDIS_PORT=6379
V5AI_REDIS_PASSWORD=xxxxxx
V5AI_REDIS_DATABASE=10
V5AI_REDIS_KEY_PREFIX=v5ai

# -----------------------------------------------------------------------------
# 通用资源存储（plm_resource）：LOCAL=本地磁盘 MINIO=MinIO
# -----------------------------------------------------------------------------
V5AI_STORAGE_TYPE=LOCAL
# LOCAL 模式的存储根目录（对应 v5ai.storage.local-dir）
V5AI_STORAGE_LOCAL_DIR=./v5ai-upload
# MINIO 模式下使用（对应 v5ai.minio.*）
V5AI_MINIO_ENDPOINT=http://localhost:9000
V5AI_MINIO_ACCESS_KEY=minioadmin
V5AI_MINIO_SECRET_KEY=minioadmin
V5AI_MINIO_BUCKET=v5ai

# -----------------------------------------------------------------------------
# Agent 运行时（对应 v5ai.agentscope.*）
# -----------------------------------------------------------------------------
# Agent 工作区（Skill 文件注入目录）
V5AI_AGENTSCOPE_WORKSPACE=.agentscope/workspace
# Agent 状态目录
V5AI_AGENTSCOPE_STATE_DIR=.agentscope/state
# 联网搜索（Tavily）API Key；为空则不启用联网搜索工具
V5AI_TAVILY_API_KEY=
# 模型连通性测试与 Agent 配置生成超时（毫秒，默认 90000=90s；Ollama 冷启动加载大模型可能较慢）
V5AI_MODEL_CONNECTION_TEST_TIMEOUT_MS=90000

# -----------------------------------------------------------------------------
# RAG 外部文档解析服务（Docling / MinerU）
# -----------------------------------------------------------------------------
# 是否启用 Docling；知识库选择 docling 时，关闭或服务异常会回退内置解析器
V5AI_DOCLING_ENABLED=false
# Docling Serve 地址
V5AI_DOCLING_URL=http://127.0.0.1:5001
# Docling 可选 API Key
V5AI_DOCLING_API_KEY=
# Docling HTTP 连接超时（毫秒）
V5AI_DOCLING_CONNECT_TIMEOUT_MS=5000
# Docling HTTP 读取超时（毫秒）
V5AI_DOCLING_READ_TIMEOUT_MS=600000
# Docling 异步任务轮询间隔（毫秒）
V5AI_DOCLING_POLL_INTERVAL_MS=2000
# 单个 Docling 异步任务最长等待时间（毫秒）
V5AI_DOCLING_POLL_TIMEOUT_MS=1800000
# Worker 并发处理 Docling 任务数
V5AI_DOCLING_CONCURRENCY=3
# 是否启用 MinerU；知识库选择 mineru 时，关闭或服务异常会回退内置解析器
V5AI_MINERU_ENABLED=false
# MinerU Router 地址
V5AI_MINERU_URL=http://127.0.0.1:8000
# MinerU HTTP 连接超时（毫秒）
V5AI_MINERU_CONNECT_TIMEOUT_MS=5000
# MinerU HTTP 读取超时（毫秒）
V5AI_MINERU_READ_TIMEOUT_MS=600000
# MinerU 异步任务轮询间隔（毫秒）
V5AI_MINERU_POLL_INTERVAL_MS=3000
# 单个 MinerU 异步任务最长等待时间（毫秒）
V5AI_MINERU_POLL_TIMEOUT_MS=1800000

# -----------------------------------------------------------------------------
# MCP
# -----------------------------------------------------------------------------
# Stdio MCP 命令白名单（逗号分隔）；为空表示开发模式不限制，生产必须配置
# 项可写纯文件名（node.exe）或完整路径（D:/nvm/v24.9.0/node.exe）（对应 v5ai.mcp.stdio-command-whitelist）
V5AI_MCP_STDIO_COMMAND_WHITELIST=

# -----------------------------------------------------------------------------
# 文件上传（对应 spring.servlet.multipart.*）
# -----------------------------------------------------------------------------
V5AI_UPLOAD_MAX_FILE_SIZE=50MB
V5AI_UPLOAD_MAX_REQUEST_SIZE=60MB

# -----------------------------------------------------------------------------
# 其他
# -----------------------------------------------------------------------------
# 覆盖 Maven 构建时写入的 spring.profiles.active（dev / home）
# SPRING_PROFILES_ACTIVE=dev
# 可选：Embedding 模型通过 Admin API 配置；未配置时使用本地 Hash 嵌入（1536 维）

# ----------------------------------------------------------------------------
# Docker Compose 专用变量（script/docker/docker-compose.yml）
# ----------------------------------------------------------------------------
POSTGRES_DB=v5ai_nb
POSTGRES_USER=v5ai
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
V5AI_PORT=8080
# nginx 前端站点（管理端 /、对话门户 /chat/、API 经 /prod-api 转发）
NGINX_HTTP_PORT=80
