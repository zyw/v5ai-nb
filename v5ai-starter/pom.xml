<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>xin.v5ai.nb</groupId>
        <artifactId>v5ai-nb</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>v5ai-starter</artifactId>
    <dependencies>
        <dependency>
            <groupId>xin.v5ai.nb</groupId>
            <artifactId>v5ai-platform</artifactId>
        </dependency>
        <dependency>
            <groupId>xin.v5ai.nb</groupId>
            <artifactId>v5ai-agent</artifactId>
        </dependency>
        <dependency>
            <groupId>xin.v5ai.nb</groupId>
            <artifactId>v5ai-model</artifactId>
        </dependency>
        <dependency>
            <groupId>xin.v5ai.nb</groupId>
            <artifactId>v5ai-rag</artifactId>
        </dependency>
        <dependency>
            <groupId>xin.v5ai.nb</groupId>
            <artifactId>v5ai-skill</artifactId>
        </dependency>
        <dependency>
            <groupId>xin.v5ai.nb</groupId>
            <artifactId>v5ai-mcp</artifactId>
        </dependency>
        <dependency>
            <groupId>xin.v5ai.nb</groupId>
            <artifactId>v5ai-workflow</artifactId>
        </dependency>
        <dependency>
            <groupId>xin.v5ai.nb</groupId>
            <artifactId>v5ai-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>xin.v5ai.nb</groupId>
            <artifactId>v5ai-worker</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 集成测试使用 H2 内存库（Flyway/ID/上下文启动测试） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Flyway 迁移（迁移脚本在 v5ai-platform 的 db/migration） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Flyway 10+ 将数据库方言拆分为独立模块；缺少则报 Unsupported Database: PostgreSQL -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!--
          Spring Boot 4 将 Flyway 自动装配从 spring-boot-autoconfigure 移出到独立构件；
          缺少本依赖时 spring.flyway.* 配置不生效，迁移不会执行。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- 运行时基础设施：Redis / MinIO（测试中 mock） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>xin.v5ai.nb</groupId>
            <artifactId>v5ai-common-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>xin.v5ai.nb</groupId>
            <artifactId>v5ai-common-storage</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
